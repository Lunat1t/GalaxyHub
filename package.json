{
  "name": "galaxy-hub",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names web,world \"npm:dev:web\" \"npm:dev:world\"",
    "build": "next build",
    "start": "next start",
    "world": "tsx src/world/server.ts",
    "typecheck": "tsc --noEmit",
    "dev:web": "next dev --hostname 0.0.0.0",
    "dev:world": "tsx watch src/world/server.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "check:services": "tsx scripts/check-services.ts",
    "check:cafe": "tsx scripts/check-cafe.ts",
    "serve": "tsx src/server.ts",
    "check:v1": "tsx scripts/check-v1.ts",
    "check:browser": "node scripts/check-browser.cjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.5",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "colyseus.js": "^0.16.22",
    "dotenv": "^18.0.7",
    "next": "^15.5.4",
    "pg": "^8.23.1",
    "phaser": "^3.90.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tsx": "^4.20.5",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.2",
    "playwright": "1.64.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "postcss": "8.5.29"
  }
}

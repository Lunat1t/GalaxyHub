# Copy to .env. Demo uses deterministic lexical hashes, not semantic embeddings.
GALAXY_MODE=demo
HOST=127.0.0.1
PORT=8787
GALAXY_DB=./data/retrieval.sqlite
GALAXY_TOKENS='[{"token":"replace-with-a-random-secret-24-chars-minimum","tenant":"galaxyhub","rooms":["cafe","project-demo"],"role":"writer"}]'
CHUNK_SIZE=400
CHUNK_OVERLAP=80
# To use remote models, set GALAXY_MODE=remote, choose a NEW database,
# and explicitly configure all the following (no automatic paid calls in demo).
ANTHROPIC_API_KEY=
CONTEXT_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_URL=
# Optional Cohere-compatible reranking:
RERANK_API_KEY=
RERANK_MODEL=
RERANK_URL=https://api.cohere.com/v2/rerank
